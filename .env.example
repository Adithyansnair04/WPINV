# Copy to .env and fill in. Never commit .env.

# --- LLM ---------------------------------------------------------------
# Format provider:model. Providers: mistral, groq, gemini, openrouter, compat (any OpenAI-compatible URL), or "rules" (no LLM).
LLM_MODEL=gemini:gemini-3.1-flash-lite
# Backup when LLM_MODEL fails (overloaded / rate-limited / timeout / bad output). Needs its provider key. Empty = no backup.
LLM_FALLBACK_MODEL=groq:openai/gpt-oss-120b
# Models compared by `npm run eval` (comma separated). "oracle" and "rules" need no key.
EVAL_MODELS=oracle,rules,gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash
# Optional cross-vendor check: add gemini:gemini-2.5-flash-lite (or the current Flash-Lite id) with GEMINI_API_KEY
# Pause between model calls during eval (helps stay under free-tier RPM limits).
EVAL_DELAY_MS=2500
LLM_TIMEOUT_MS=30000
# Free key: https://console.mistral.ai (Experiment plan, phone verification, no card)
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# COMPAT_BASE_URL=http://localhost:11434/v1
# COMPAT_API_KEY=

# --- Zoho Books ----------------------------------------------------------
# mock = in-memory seed data (safe default). live = real Zoho Books API.
ZOHO_MODE=mock
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# India data centre defaults; use .com/.eu/.com.au etc. for other DCs.
ZOHO_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_TIMEOUT_MS=20000
# Safety switch: in live mode invoices are only created when this is true; otherwise the bot replies with a dry-run preview.
INVOICE_ALLOW_LIVE_CREATE=false

# --- Chat transport -------------------------------------------------------------
# telegram (default; official Bot API, groups supported, no public URL needed) | whatsapp_cloud (official, 1:1 only) | baileys (unofficial WhatsApp groups, ban risk)
CHAT_TRANSPORT=telegram
# Skip messages older than this (avoids processing backlog after downtime).
MAX_MESSAGE_AGE_SEC=600

# --- Telegram -------------------------------------------------------------------
# From @BotFather (/newbot). Keep secret.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot acts in (groups are negative, e.g. -1001234567890). Unlisted chats are logged once with their id.
TELEGRAM_ALLOWED_CHATS=

# --- WhatsApp (only for CHAT_TRANSPORT=whatsapp_cloud or baileys) -------------------
# From developers.facebook.com > your app > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
# Temporary token (expires in 24h) or a permanent System User token
WA_ACCESS_TOKEN=
# App settings > Basic > App secret (used to verify webhook signatures)
WA_APP_SECRET=
# Any random string; enter the same value as "Verify token" when configuring the webhook
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v25.0
# Comma-separated sender numbers allowed to request invoices (digits only, e.g. 919876543210). Others are ignored and logged once.
WA_ALLOWED_SENDERS=
# Local port for the webhook server (expose via cloudflared/ngrok)
PORT=3000
# Baileys settings (only used when CHAT_TRANSPORT=baileys)
WA_AUTH_DIR=.data/wa-auth
WA_ALLOWED_GROUPS=

# --- Dashboard (read-only, no auth: keep it on localhost) -----------------------
# 0 disables it. Open http://127.0.0.1:3001 while the bot runs.
DASHBOARD_PORT=3001
DASHBOARD_HOST=127.0.0.1

# --- Behaviour ---------------------------------------------------------------
# Add customers from chat ("add customer <name>" or the ➕ option): confirm = only after an explicit Yes; off = disabled.
CUSTOMER_CREATE=confirm
# Optional: comma-separated sender ids allowed to add customers (empty = any member of an allowed chat). Send /whoami to the bot to see your id.
CUSTOMER_CREATORS=
CLARIFY_TTL_MINUTES=15
# ask = clarify when no rate is given; item_default = use the Zoho item's selling rate.
RATE_POLICY=ask
# Tax % for invoice lines whose Zoho item has no tax, e.g. 18. Requires a GST-registered Zoho org and a tax with this % (npm run zoho:seed -- --confirm --tax 18). Empty = off.
DEFAULT_TAX_PERCENT=
BASE_CURRENCY=INR
LOG_LEVEL=info
# Log raw message text (contains customer data). Keep false outside debugging.
LOG_MESSAGE_TEXT=false
DATA_DIR=.data
